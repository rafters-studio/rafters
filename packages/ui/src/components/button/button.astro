---
/**
 * Button -- the Astro performance of the score (button.behavior.ts).
 *
 * A static tier has no client runtime: this performance computes the
 * INITIAL contract from config -- initialState, aria, classes -- and
 * renders it once, server-side. No effects (Spec 03: the announce effect
 * needs an executor, which needs a runtime), no keyboard branches (a
 * native <button> already fires click on Enter/Space -- Spec 01 rule 5 --
 * and there is no dispatch loop here to feed), no onClick/onPressedChange
 * (those exist to report ACCEPTED dispatches, and nothing dispatches).
 * `toggle` + `defaultPressed` still render correctly: they are config, and
 * config is exactly what a static render can honor.
 *
 * Ids are inputs the behavior never generates (Spec 01 rule 3). This tier
 * has no adapter to supply stable ones (no useId, no instance counter),
 * and pressable's aria projection never reads the ids it is handed --
 * empty strings satisfy the signature without inventing id-supply
 * machinery this performance has no runtime use for.
 */
import type { HTMLAttributes } from 'astro/types';
import type { PartIds } from '../../lib/contract';
import classy from '../../primitives/classy';
import { button, type ButtonConfig, type ButtonPart, type ButtonSize, type ButtonVariant } from './button.behavior';
import { buttonClasses } from './button.classes';

export { buttonVariants } from './button.classes';

interface Props extends HTMLAttributes<'button'> {
  variant?: ButtonVariant;
  size?: ButtonSize;
  loading?: boolean;
  softDisabled?: boolean;
  toggle?: boolean;
  defaultPressed?: boolean;
}

const {
  variant = 'default',
  size = 'default',
  disabled = false,
  loading = false,
  softDisabled = false,
  toggle = false,
  defaultPressed = false,
  type,
  class: className,
  ...attrs
} = Astro.props;

const config: ButtonConfig = {
  variant,
  size,
  toggle,
  defaultPressed,
  disabled,
  softDisabled,
  loading,
};

const state = button.initialState(config);
const classes = buttonClasses(config, state);
const ids: PartIds<ButtonPart> = { root: '', label: '', spinner: '' };
const aria = button.aria(state, config, ids);
---

<button
  type={type ?? 'button'}
  disabled={disabled}
  data-part="root"
  class={classy(classes.root, className)}
  {...aria.root}
  {...attrs}
>
  {loading && (
    <svg
      data-part="spinner"
      class={classes.spinner}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      {...aria.spinner}
    >
      <path d="M21 12a9 9 0 1 1-6.219-8.56" />
    </svg>
  )}
  <span data-part="label"><slot /></span>
</button>
