---
/**
 * button.astro -- Astro binding. Server-rendered wiring only (Spec 01):
 * zero client JavaScript, so it projects the behavior's INITIAL state --
 * the same initialState/aria/classes the other bindings use. Interactive
 * states (toggle flips, loading transitions) belong to the client bindings;
 * this target renders whatever state the server knows.
 */
import type { HTMLAttributes } from 'astro/types';
import classy from '../../primitives/classy';
import {
  buttonBehavior,
  type ButtonConfig,
  type ButtonSize,
  type ButtonVariant,
} from './button.behavior';
import { buttonClasses } from './button.classes';

interface Props extends HTMLAttributes<'button'> {
  variant?: ButtonVariant;
  size?: ButtonSize;
  loading?: boolean;
  softDisabled?: boolean;
  toggle?: boolean;
  pressed?: boolean;
}

const {
  variant = 'default',
  size = 'default',
  disabled = false,
  loading = false,
  softDisabled = false,
  toggle = false,
  pressed = false,
  type = 'button',
  class: className,
  id,
  ...attrs
} = Astro.props;

const config: ButtonConfig = {
  variant,
  size,
  toggle,
  disabled: disabled === true,
  softDisabled,
  loading,
  pressed,
};

const uid = id ?? `rafters-button-${Math.random().toString(36).slice(2, 10)}`;
const ids = { root: String(uid), label: `${uid}-label`, spinner: `${uid}-spinner` };

const state = buttonBehavior.initialState(config);
const aria = buttonBehavior.aria(state, config, ids);
const classes = buttonClasses(config, state);
const cls = classy(classes.root, className);

const rootAria = Object.fromEntries(
  Object.entries(aria.root ?? {}).filter(([, value]) => value !== undefined),
);
---

<button
  type={type}
  class={cls}
  disabled={state.disabled}
  data-part="root"
  {...rootAria}
  {...attrs}
>
  {
    state.loading ? (
      <svg
        data-part="spinner"
        id={ids.spinner}
        class={classes.spinner}
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M21 12a9 9 0 1 1-6.219-8.56" />
      </svg>
    ) : null
  }
  <span data-part="label" id={ids.label}><slot /></span>
</button>
