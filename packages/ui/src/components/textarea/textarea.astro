---
/**
 * Astro performance (controller) for textarea.
 *
 * Server-renders the light-DOM <textarea> with classes and the score's initial
 * validity projection already applied, so the field is correct before any JS.
 * The <script> then hands each instance to bindTextarea -- the SAME DOM-native
 * controller the Web Component uses. One score, three performances, zero drift.
 *
 * Unlike input, a <textarea> holds its initial value as CHILD TEXT, not a
 * `value` attribute, so the seeded value is rendered between the tags.
 *
 * The projection is computed here from the same textareaBehavior.aria the React
 * and WC controllers read.
 */
import {
  textareaBehavior,
  type TextareaConfig,
  type TextareaPart,
} from './textarea.behavior';
import { textareaClassSet } from './textarea.classes';
import type { PartIds } from '../../lib/contract';

interface Props {
  id: string;
  value?: string;
  defaultValue?: string;
  name?: string;
  placeholder?: string;
  rows?: number;
  disabled?: boolean;
  readonly?: boolean;
  required?: boolean;
  invalid?: boolean;
  /** Optional error message; rendered as the aria-describedby target. */
  error?: string;
}

const {
  id,
  value,
  defaultValue,
  name,
  placeholder,
  rows,
  disabled = false,
  readonly = false,
  required = false,
  invalid = false,
  error,
} = Astro.props;

const config: TextareaConfig = { value, defaultValue, disabled, readonly, required, invalid };
const state = textareaBehavior.initialState(config);
const classes = textareaClassSet(config, state);

const ids = {} as PartIds<TextareaPart>;
for (const part of Object.keys(textareaBehavior.parts) as TextareaPart[]) {
  ids[part] = part === 'error' && error ? `${id}-error` : part === 'textarea' ? id : '';
}
const projection = textareaBehavior.aria(state, config, ids);
const seeded = config.value ?? config.defaultValue ?? '';
---

<textarea
  data-part="textarea"
  id={id}
  name={name}
  placeholder={placeholder}
  rows={rows}
  disabled={disabled}
  readonly={readonly}
  class={classes.textarea}
  {...projection.textarea}
>{seeded}</textarea>
{
  error && (
    <div data-part="error" id={ids.error} class={classes.error}>
      {error}
    </div>
  )
}

<script>
  import { bindTextarea } from './textarea.behavior';

  // The <script> is bundled and runs once per page; bind every instance's
  // server-rendered markup. Same controller as the Web Component. The
  // textarea's parent is the binding root so the delegated 'input' listener and
  // the error sibling both fall under it.
  for (const el of document.querySelectorAll<HTMLElement>('textarea[data-part="textarea"]')) {
    const root = el.parentElement;
    if (!root || root.dataset['textareaBound'] === 'true') continue;
    root.dataset['textareaBound'] = 'true';
    bindTextarea(root);
  }
</script>
