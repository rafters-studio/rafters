---
/**
 * Spinner -- the Astro performance of the static score (spinner.behavior.ts).
 *
 * A static score has nothing to subscribe to: this performance is pure
 * decoration application plus the projected accessible name. No client
 * runtime, no `<script>`, no bind (Spec 03) -- config in, classes and aria
 * out. The root classes and the `aria-label` come from the SAME projections
 * the React and Web Component performances read: one score, three
 * performances, zero drift. `<output>` supplies the implicit `role="status"`
 * natively, and the projected label is the single accessible name (no sr-only
 * span, matching the dialog/progress simplification).
 */
import type { HTMLAttributes } from 'astro/types';
import classy from '../../primitives/classy';
import { spinner, type SpinnerConfig } from './spinner.behavior';
import { spinnerClasses } from './spinner.classes';

interface Props extends HTMLAttributes<'output'> {
  size?: SpinnerConfig['size'];
  variant?: SpinnerConfig['variant'];
}

const { size, variant, class: className, ...attrs } = Astro.props;

const config: SpinnerConfig = { size, variant };
const classes = spinnerClasses(config, {});
const { root: aria } = spinner.aria({}, config, { root: '' });
---

<output data-part="root" class={classy(classes.root, className)} {...aria} {...attrs}></output>
