---
/**
 * Dropdown selection component with search and accessibility features
 *
 * @cognitive-load 5/10 - Option selection with search functionality requires cognitive processing
 * @attention-economics State management: closed=compact display, open=full options, searching=filtered results
 * @trust-building Search functionality, clear selection indication, undo patterns for accidental selections
 * @accessibility Keyboard navigation, screen reader announcements, focus management, option grouping
 * @semantic-meaning Option structure: value=data, label=display, group=categorization, disabled=unavailable choices
 *
 * @usage-patterns
 * DO: Use 3-12 choices for optimal cognitive load
 * DO: Provide clear, descriptive option text
 * DO: Pre-select most common/safe option when appropriate
 * DO: Enable search for 8+ options to reduce cognitive load
 * NEVER: Too many options without grouping, unclear option descriptions
 *
 * @example
 * ```tsx
 * // shadcn-compatible usage (drop-in replacement)
 * import { Select, SelectTrigger, SelectValue, SelectContent, SelectItem } from '@rafters/ui';
 *
 * <Select>
 *   <SelectTrigger>
 *     <SelectValue placeholder="Choose option..." />
 *   </SelectTrigger>
 *   <SelectContent>
 *     <SelectItem value="option1">Option 1</SelectItem>
 *     <SelectItem value="option2">Option 2</SelectItem>
 *   </SelectContent>
 * </Select>
 *
 * // Or with namespaced imports
 * <Select>
 *   <Select.Trigger>
 *     <Select.Value placeholder="Choose option..." />
 *   </Select.Trigger>
 *   <Select.Content>
 *     <Select.Item value="option1">Option 1</Select.Item>
 *     <Select.Item value="option2">Option 2</Select.Item>
 *   </Select.Content>
 * </Select>
 * ```
 */

/**
 * Astro performance for select. Server-renders the full light-DOM listbox
 * with the closed-state projection already applied (correct and inert before
 * JS), then the <script> hands each instance to bindSelect -- the SAME
 * DOM-native client the Web Component uses. One score, three performances.
 *
 * The listbox stays in light DOM (present-but-hidden) so the effects the bind
 * runs -- roving-focus, typeahead, dismiss-on-outside -- can read it, and the
 * value text is read from the selected option.
 *
 * Decorative icons: the `start-icon` and `end-icon` slots fill the trigger, and
 * an option's own icons fill the slots `item-start-icon-<value>` and
 * `item-end-icon-<value>`. Each renders inside a wrapper the behavior projects
 * aria-hidden="true" onto, in the server markup, so the label alone is the
 * accessible name with no script run.
 */
import {
  formValueAttrs,
  select,
  selectItemAria,
  type SelectConfig,
  type SelectPart,
} from './select.behavior';
import { selectClasses } from './select.classes';
import type { PartIds } from '../../lib/contract';

interface Option {
  value: string;
  label: string;
  disabled?: boolean;
}

interface Props {
  id: string;
  options: Option[];
  value?: string;
  placeholder?: string;
  disabled?: boolean;
  name?: string;
}

const { id, options, value = '', placeholder = 'Select an option', disabled = false, name } =
  Astro.props;

const config: SelectConfig = { defaultValue: value, disabled, name };
const state = select.initialState(config);
const classes = selectClasses(config, state);

const ids = {} as PartIds<SelectPart>;
for (const part of Object.keys(select.parts) as SelectPart[]) {
  ids[part] = `${id}-${part}`;
}
const aria = select.aria(state, config, ids);

const selected = options.find((option) => option.value === value);
const displayLabel = selected?.label ?? placeholder;
const isEmpty = selected === undefined;

// Form association composed through the form-value primitive.
const hiddenInput = formValueAttrs({ name, value });

const hasStartIcon = Astro.slots.has('start-icon');
const hasEndIcon = Astro.slots.has('end-icon');
const itemIcons = new Map<string, { start?: string | undefined; end?: string | undefined }>();
for (const option of options) {
  const start = Astro.slots.has(`item-start-icon-${option.value}`)
    ? await Astro.slots.render(`item-start-icon-${option.value}`)
    : undefined;
  const end = Astro.slots.has(`item-end-icon-${option.value}`)
    ? await Astro.slots.render(`item-end-icon-${option.value}`)
    : undefined;
  itemIcons.set(option.value, { start, end });
}
---

<rafters-select
  data-part="root"
  id={ids.root}
  value={value}
  disabled={disabled ? '' : undefined}
  name={name}
  {...aria.root}
>
  <button
    type="button"
    id={ids.trigger}
    data-part="trigger"
    disabled={disabled}
    class={classes.trigger}
    {...aria.trigger}
  >
    {
      hasStartIcon && (
        <span
          data-part="startIcon"
          data-icon="inline-start"
          class={classes.triggerStartIcon}
          {...aria.startIcon}
        >
          <slot name="start-icon" />
        </span>
      )
    }
    <div data-part="value" data-placeholder={placeholder} data-empty={isEmpty ? '' : undefined} class={classes.value}>
      {displayLabel}
    </div>
    {
      hasEndIcon && (
        <span
          data-part="endIcon"
          data-icon="inline-end"
          class={classes.triggerEndIcon}
          {...aria.endIcon}
        >
          <slot name="end-icon" />
        </span>
      )
    }
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class={classes.chevron}
      aria-hidden="true"
    >
      <path d="m6 9 6 6 6-6"></path>
    </svg>
  </button>

  <div id={ids.content} data-part="content" class={classes.content} hidden={!state.open} {...aria.content}>
    <div class={classes.viewport}>
      {
        options.map((option) => {
          const itemAria = selectItemAria(option.value, state, config);
          const icons = itemIcons.get(option.value);
          return (
            <div
              role="option"
              data-part="item"
              data-value={option.value}
              data-roving-item=""
              data-disabled={option.disabled ? '' : undefined}
              aria-disabled={option.disabled ? 'true' : undefined}
              tabindex={option.disabled ? undefined : -1}
              class={classes.item}
              {...itemAria}
            >
              <div class={classes.itemIndicator} aria-hidden="true"></div>
              {icons?.start !== undefined && (
                <span
                  data-part="startIcon"
                  data-icon="inline-start"
                  class={classes.startIcon}
                  {...aria.startIcon}
                  set:html={icons.start}
                />
              )}
              <div class={classes.itemText}>{option.label}</div>
              {icons?.end !== undefined && (
                <span
                  data-part="endIcon"
                  data-icon="inline-end"
                  class={classes.endIcon}
                  {...aria.endIcon}
                  set:html={icons.end}
                />
              )}
            </div>
          );
        })
      }
    </div>
  </div>

  {hiddenInput && <input data-part="hidden-input" {...hiddenInput} />}
</rafters-select>

<script>
  import { bindSelect } from './select.behavior';

  for (const root of document.querySelectorAll<HTMLElement>('rafters-select[data-part="root"]')) {
    if (root.dataset['bound'] === 'true') continue;
    root.dataset['bound'] = 'true';
    bindSelect(root);
  }
</script>
