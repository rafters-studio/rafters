---
/**
 * Empty state display for when there's no content to show
 *
 * @cognitive-load 2/10 - Simple informational display with clear next steps
 * @attention-economics Supportive element: Fills void without demanding attention, guides to action
 * @trust-building Honest communication about empty state builds trust; actionable guidance reduces frustration
 * @accessibility Clear heading hierarchy; actionable elements are keyboard accessible
 * @semantic-meaning State communication: empty search results, no items yet, cleared list, filtered to nothing
 *
 * @usage-patterns
 * DO: Provide actionable next steps when possible
 * DO: Explain why the state is empty (no results, no items yet, etc.)
 * DO: Use appropriate illustrations to soften the empty state
 * DO: Match tone to context (playful for personal apps, professional for business)
 * NEVER: Leave empty states blank
 * NEVER: Use generic "No data" without context
 * NEVER: Make users feel like something is broken
 *
 * @example
 * ```tsx
 * // Empty search results
 * <Empty>
 *   <EmptyIcon>
 *     <SearchIcon />
 *   </EmptyIcon>
 *   <EmptyTitle>No results found</EmptyTitle>
 *   <EmptyDescription>
 *     Try adjusting your search terms or filters.
 *   </EmptyDescription>
 *   <EmptyAction>
 *     <Button variant="outline" onClick={clearFilters}>
 *       Clear filters
 *     </Button>
 *   </EmptyAction>
 * </Empty>
 *
 * // Empty list (first time)
 * <Empty>
 *   <EmptyIcon>
 *     <FolderIcon />
 *   </EmptyIcon>
 *   <EmptyTitle>No projects yet</EmptyTitle>
 *   <EmptyDescription>
 *     Create your first project to get started.
 *   </EmptyDescription>
 *   <EmptyAction>
 *     <Button>Create project</Button>
 *   </EmptyAction>
 * </Empty>
 *
 * // Informational only (no action)
 * <Empty>
 *   <EmptyIcon>
 *     <InboxIcon />
 *   </EmptyIcon>
 *   <EmptyTitle>All caught up!</EmptyTitle>
 *   <EmptyDescription>
 *     No new notifications.
 *   </EmptyDescription>
 * </Empty>
 * ```
 */

/**
 * Astro performance of the Empty score.
 *
 * Empty is a PURE STATIC: the score projects no ARIA, holds no state, and runs
 * no effects. So this file ships NO `<script>` and imports NO `bindEmpty`
 * (there is none) -- it is server-rendered markup with the shared class strings
 * and named slots, and there is nothing to hydrate. The root classes come from
 * the SAME `emptyClasses` projection the React and Web Component performances
 * read -- one score, three performances, zero drift.
 */
import {
  emptyActionClasses,
  emptyClasses,
  type EmptyClassSet,
  emptyDescriptionClasses,
  emptyIconClasses,
  emptyTitleClasses,
} from './empty.classes';

interface Props {
  class?: string;
}

const { class: className, ...attrs } = Astro.props;

const classes: EmptyClassSet = emptyClasses({}, {});
const rootClass = [classes.root, className].filter(Boolean).join(' ');
---

<div data-part="root" class={rootClass} {...attrs}>
  <div data-slot="empty-icon" class={emptyIconClasses}><slot name="icon" /></div>
  <div data-slot="empty-title" class={emptyTitleClasses}><slot name="title" /></div>
  <div data-slot="empty-description" class={emptyDescriptionClasses}>
    <slot name="description" />
  </div>
  <div data-slot="empty-action" class={emptyActionClasses}><slot name="action" /></div>
  <slot />
</div>
