---
/**
 * SidebarMenuSubButton -- the Astro performance of a submenu item's button,
 * importable on its own so an Astro tree composes exactly like the React
 * tree: `<SidebarMenuSubItem><SidebarMenuSubButton asChild><a href="/x">Home</a></SidebarMenuSubButton></SidebarMenuSubItem>`.
 * Draws from the SAME class projection (`sidebarMenuSubButtonClasses`) in
 * sidebar.classes.ts the React performance reads -- one score, one
 * composition, no drift. Renders `<a>` by default, matching the React
 * performance (`sidebar.tsx:599`).
 *
 * `asChild` (Decision 2, 2026-09-09): render-then-inject via
 * `primitives/astro-as-child.ts`. When true, the default slot renders to a
 * string, is parsed with ultrahtml, and this part's class + `data-sidebar` /
 * `data-size` / `data-active` land on the FIRST element of that markup (its
 * own `class` dropped); when false or absent, this file renders its own
 * `<a>`.
 *
 * `class` is NOT a prop -- design travels through token props only. It is
 * discarded so `...attrs` cannot carry it onto the element.
 *
 * @parent sidebar
 * @dependencies astro
 * @primitives astro-as-child
 */
import type { HTMLAttributes } from 'astro/types';
import { injectAsChildAttrs } from '../../primitives/astro-as-child';
import { sidebarIconsMarkup } from './sidebar.behavior';
import { sidebarMenuSubButtonClasses } from './sidebar.classes';

type Props = Omit<HTMLAttributes<'a'>, 'class'> & {
  asChild?: boolean;
  isActive?: boolean;
  size?: 'sm' | 'md';
};

const {
  class: _discardedClass,
  asChild = false,
  isActive = false,
  size = 'md',
  ...attrs
} = Astro.props as Props & { class?: string };

const decoration = {
  class: sidebarMenuSubButtonClasses(size),
  'data-sidebar': 'menu-sub-button',
  'data-size': size,
  'data-active': isActive ? 'true' : 'false',
};

// Decorative icons arrive as the named slots `start-icon` and `end-icon`. Each
// wrapper is present only when its slot is given and carries the behavior's
// `aria-hidden`, so the label alone is the accessible name with no script run.
const startHtml = Astro.slots.has('start-icon') ? await Astro.slots.render('start-icon') : '';
const endHtml = Astro.slots.has('end-icon') ? await Astro.slots.render('end-icon') : '';

let injected: string | null = null;
if (asChild) {
  const slotHtml = await Astro.slots.render('default');
  injected = injectAsChildAttrs(
    slotHtml,
    attrs,
    decoration,
    startHtml || endHtml ? (inner) => sidebarIconsMarkup(inner, startHtml, endHtml) : undefined,
  );
}
const content =
  injected === null
    ? sidebarIconsMarkup(await Astro.slots.render('default'), startHtml, endHtml)
    : '';
---

{
  injected !== null ? (
    <Fragment set:html={injected} />
  ) : (
    <a {...decoration} {...attrs}>
      <Fragment set:html={content} />
    </a>
  )
}
