---
/**
 * SidebarMenuAction -- the Astro performance of a menu item's action button,
 * importable on its own so an Astro tree composes exactly like the React
 * tree: `<SidebarMenuItem><SidebarMenuButton/><SidebarMenuAction><More/></SidebarMenuAction></SidebarMenuItem>`.
 * Draws from the SAME class strings in sidebar.classes.ts the React
 * performance reads -- one score, one composition, no drift.
 *
 * `asChild` (Decision 2, 2026-09-09): render-then-inject via
 * `primitives/astro-as-child.ts`. When true, the default slot renders to a
 * string, is parsed with ultrahtml, and this part's class + `data-sidebar`
 * land on the FIRST element of that markup (its own `class` dropped); when
 * false or absent, this file renders its own `<button>`. Consumer syntax
 * matches shadcn's: `<SidebarMenuAction asChild><a href="/x"><More/></a></SidebarMenuAction>`.
 *
 * `class` is NOT a prop -- design travels through token props only. It is
 * discarded so `...attrs` cannot carry it onto the element.
 *
 * @parent sidebar
 */
import type { HTMLAttributes } from 'astro/types';
import { injectAsChildAttrs } from '../../primitives/astro-as-child';
import { sidebarClasses } from './sidebar.classes';

type Props = Omit<HTMLAttributes<'button'>, 'class'> & {
  asChild?: boolean;
  showOnHover?: boolean;
};

const {
  class: _discardedClass,
  asChild = false,
  showOnHover = false,
  ...attrs
} = Astro.props as Props & { class?: string };

const classes = sidebarClasses();
const classString = [classes.menuAction, showOnHover ? classes.menuActionShowOnHover : '']
  .filter(Boolean)
  .join(' ');
const decoration = { class: classString, 'data-sidebar': 'menu-action' };

let injected: string | null = null;
if (asChild) {
  const slotHtml = await Astro.slots.render('default');
  injected = injectAsChildAttrs(slotHtml, attrs, decoration);
}
---

{
  injected !== null ? (
    <Fragment set:html={injected} />
  ) : (
    <button type="button" {...decoration} {...attrs}>
      <slot />
    </button>
  )
}
