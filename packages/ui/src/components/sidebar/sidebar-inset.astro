---
/**
 * SidebarInset -- the Astro performance of Sidebar's `<main>` landmark,
 * importable on its own so an Astro tree composes exactly like the React
 * tree: `<Sidebar>...</Sidebar><SidebarInset>...</SidebarInset>`, siblings
 * under the same provider region. Pure decoration -- no behavior, no state --
 * modelled on `card-header.astro`. Draws from the SAME class string in
 * sidebar.classes.ts the React performance reads -- one score, one
 * composition, no drift.
 *
 * `class` is NOT a prop -- design travels through token props only. It is
 * discarded so `...attrs` cannot carry it onto the element.
 *
 * @parent sidebar
 */
import type { HTMLAttributes } from 'astro/types';
import { sidebarClasses } from './sidebar.classes';

type Props = Omit<HTMLAttributes<'main'>, 'class'>;

const { class: _discardedClass, ...attrs } = Astro.props as Props & { class?: string };
const classes = sidebarClasses();
---

<main data-part="inset" class={classes.inset} {...attrs}>
  <slot />
</main>
