---
/**
 * User representation component with image and fallback support
 *
 * @cognitive-load 2/10 - Simple display element with predictable behavior
 * @attention-economics Peripheral element: Supports content identification without demanding focus
 * @trust-building Consistent representation builds user recognition; fallbacks prevent broken states
 * @accessibility Alt text required for images; decorative avatars use aria-hidden
 * @semantic-meaning Size hierarchy: xs/sm=inline mentions, md=lists, lg/xl=profiles
 *
 * @usage-patterns
 * DO: Always provide alt text for meaningful avatars
 * DO: Use AvatarFallback for graceful degradation
 * DO: Match size to context (small in lists, large in profiles)
 * DO: Use delayMs on fallback to prevent loading flash
 * NEVER: Use without fallback - images fail
 * NEVER: Rely solely on avatar for identification - pair with name
 * NEVER: Use inconsistent sizes within the same context
 *
 * @example
 * ```tsx
 * // Basic avatar with fallback
 * <Avatar>
 *   <AvatarImage src="/user.jpg" alt="Jane Doe" />
 *   <AvatarFallback>JD</AvatarFallback>
 * </Avatar>
 *
 * // Large profile avatar
 * <Avatar size="xl">
 *   <AvatarImage src="/profile.jpg" alt="User profile" />
 *   <AvatarFallback delayMs={600}>
 *     <UserIcon className="h-8 w-8" />
 *   </AvatarFallback>
 * </Avatar>
 *
 * // Decorative avatar (aria-hidden)
 * <Avatar aria-hidden="true">
 *   <AvatarImage src="/bot.png" alt="" />
 *   <AvatarFallback>AI</AvatarFallback>
 * </Avatar>
 * ```
 */

/**
 * Avatar -- the Astro performance of the Avatar score.
 *
 * A caller-decides static, zero client JavaScript, matching the oracle: the
 * caller passes `src` to render the image, or omits it (or sets `status`) to
 * fall back. Presence is the SAME `resolveAvatar` the React and Web Component
 * performances read -- one score, three performances, zero drift. There is no
 * `<script>` and no `bindAvatar`; there is nothing to hydrate.
 */
import type { HTMLAttributes } from 'astro/types';
import classy from '../../primitives/classy';
import {
  type AvatarConfig,
  type AvatarSize,
  type AvatarStatus,
  resolveAvatar,
} from './avatar.behavior';
import { avatarClasses } from './avatar.classes';

interface Props extends HTMLAttributes<'span'> {
  size?: AvatarSize;
  src?: string;
  alt?: string;
  /** Explicit load outcome; defaults from `src` (present -> loaded). */
  status?: AvatarStatus;
  /** Fallback text; omit to use the default slot for the initials/icon. */
  fallback?: string;
}

const { size, src, alt = '', status, fallback, class: className, ...attrs } = Astro.props;

const effectiveStatus: AvatarStatus = status ?? (src ? 'loaded' : 'error');
const config: AvatarConfig = { size, status: effectiveStatus };
const resolved = resolveAvatar(config);
const classes = avatarClasses(config);
const rootClass = classy(classes.root, className);
---

<span data-part="root" class={rootClass} {...attrs}>
  {!resolved.imageHidden && src && (
    <img data-part="image" src={src} alt={alt} class={classes.image} />
  )}
  {!resolved.fallbackHidden && (
    <span data-part="fallback" class={classes.fallback}>
      {fallback ? fallback : <slot />}
    </span>
  )}
</span>
