---
/**
 * Form input component with validation states and accessibility
 *
 * @cognitive-load 4/10 - Data entry with validation feedback requires user attention
 * @attention-economics State hierarchy: default=ready, focus=active input, error=requires attention, success=validation passed
 * @trust-building Clear validation feedback, error recovery patterns, progressive enhancement
 * @accessibility Screen reader labels, validation announcements, keyboard navigation, high contrast support
 * @semantic-meaning Type-appropriate validation: email=format validation, password=security indicators, number=range constraints
 *
 * @usage-patterns
 * DO: Always pair with descriptive Label component
 * DO: Use helpful placeholders showing format examples
 * DO: Provide real-time validation for user confidence
 * DO: Use appropriate input types for sensitive data
 * NEVER: Label-less inputs, validation only on submit, unclear error messages
 *
 * @example
 * ```tsx
 * // Basic input with label
 * <Label htmlFor="email">Email</Label>
 * <Input id="email" type="email" placeholder="you@example.com" />
 *
 * // Error state
 * <Input variant="error" placeholder="Invalid input" />
 *
 * // Success state
 * <Input variant="success" defaultValue="Valid input" />
 *
 * // Sizes
 * <Input size="sm" placeholder="Small" />
 * <Input size="lg" placeholder="Large" />
 * ```
 *
 * @dependencies astro
 * @components input-group
 * @lib contract
 */

/**
 * Astro performance (controller) for input.
 *
 * Server-renders the light-DOM <input> with classes and the score's initial
 * validity projection already applied, so the field is correct before any JS.
 * The <script> then hands each instance to bindInput -- the SAME DOM-native
 * controller the Web Component uses. One score, three performances, zero drift.
 *
 * The projection is computed here from the same inputBehavior.aria the React
 * and WC controllers read.
 */
import type { HTMLAttributes } from 'astro/types';
import { inputBehavior, type InputConfig, type InputPart } from './input.behavior';
import { inputClassSet } from './input.classes';
import { addonPart, inputGroupBehavior } from '../input-group/input-group.behavior';
import type { PartIds } from '../../lib/contract';

interface Props {
  id: string;
  value?: string;
  defaultValue?: string;
  type?: HTMLAttributes<'input'>['type'];
  name?: string;
  placeholder?: string;
  disabled?: boolean;
  readonly?: boolean;
  required?: boolean;
  invalid?: boolean;
  /** Optional error message; rendered as the aria-describedby target. */
  error?: string;
}

const {
  id,
  value,
  defaultValue,
  type = 'text',
  name,
  placeholder,
  disabled = false,
  readonly = false,
  required = false,
  invalid = false,
  error,
} = Astro.props;

const hasStart = Astro.slots.has('start-icon');
const hasEnd = Astro.slots.has('end-icon');
const hasIcons = hasStart || hasEnd;
const config: InputConfig = {
  value,
  defaultValue,
  disabled,
  readonly,
  required,
  invalid,
  startIcon: hasStart,
  endIcon: hasEnd,
};
const state = inputBehavior.initialState(config);
const classes = inputClassSet(config, state);

const ids = {} as PartIds<InputPart>;
for (const part of Object.keys(inputBehavior.parts) as InputPart[]) {
  ids[part] = part === 'error' && error ? `${id}-error` : part === 'input' ? id : '';
}
const projection = inputBehavior.aria(state, config, ids);
const groupAria = inputGroupBehavior.aria(
  {},
  {},
  { root: '', control: '', addonStart: '', addonEnd: '' },
);
const startPart = addonPart('start');
const endPart = addonPart('end');
// With no icon the field renders bare, as before: a fragment, not a row.
const Row = hasIcons ? 'div' : Fragment;
const rowProps = hasIcons ? { 'data-part': 'row', class: classes.row } : {};
const seeded = config.value ?? config.defaultValue ?? '';
---

<Row {...rowProps}>
{
  hasStart && (
    <div data-part={startPart} class={classes.addonStart} {...groupAria[startPart]}>
      <span
        data-part="startIcon"
        data-icon="inline-start"
        class={classes.startIcon}
        {...projection.startIcon}
      >
        <slot name="start-icon" />
      </span>
    </div>
  )
}
<input
  data-part="input"
  id={id}
  type={type}
  name={name}
  placeholder={placeholder}
  value={seeded}
  disabled={disabled}
  readonly={readonly}
  class={hasIcons ? classes.rowInput : classes.input}
  {...projection.input}
/>
{
  hasEnd && (
    <div data-part={endPart} class={classes.addonEnd} {...groupAria[endPart]}>
      <span
        data-part="endIcon"
        data-icon="inline-end"
        class={classes.endIcon}
        {...projection.endIcon}
      >
        <slot name="end-icon" />
      </span>
    </div>
  )
}
</Row>
{
  error && (
    <div data-part="error" id={ids.error} class={classes.error}>
      {error}
    </div>
  )
}

<script>
  import { bindInput } from './input.behavior';

  // The <script> is bundled and runs once per page; bind every instance's
  // server-rendered markup. Same controller as the Web Component. The input's
  // parent is the binding root so the delegated 'input' listener and the error
  // sibling both fall under it.
  for (const el of document.querySelectorAll<HTMLElement>('input[data-part="input"]')) {
    // With icons the field sits in a row; the root is the row's parent so the
    // error sibling still falls under the bind.
    const root = (el.closest('[data-part="row"]') ?? el).parentElement;
    if (!root || root.dataset['inputBound'] === 'true') continue;
    root.dataset['inputBound'] = 'true';
    bindInput(root);
  }
</script>
