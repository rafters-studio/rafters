  "  --rafters-ease-spring-snappy: cubic-bezier(0.2, 0.8, 0.2, 1);",
  "  --rafters-delay-hover-intent: 200ms;",
  "  --rafters-delay-linger: 300ms;",
  "  --rafters-delay-choreo-step: 50ms;",
