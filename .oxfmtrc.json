{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 100,
  "singleQuote": true,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": true,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "ignorePatterns": [
    "**/node_modules",
    "**/dist",
    "**/build",
    "**/.turbo",
    "**/.astro",
    "**/*.log",
    "**/*.md",
    "**/*.mdx",
    "**/*.yml",
    "**/*.yaml",
    "playwright-report",
    "test-results",
    "**/.cache",
    "**/*.vue",
    "**/worker-configuration.d.ts",
    "apps/demo/src/styles/global.css",
    ".claude/worktrees",
    "docs-site",
    "docs/templates",
    "**/__fixtures__/**/*.css"
  ]
}
