{
  "name": "rafters-monorepo",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:unit": "pnpm -r test:unit",
    "test:e2e": "pnpm -r --if-present test:e2e",
    "test:e2e:browser": "playwright test",
    "test:a11y": "pnpm -r test:a11y",
    "test:quick": "pnpm test:unit && pnpm test:a11y",
    "test:all": "pnpm preflight && pnpm -r test:integration && pnpm test:e2e && pnpm test:e2e:browser",
    "test:watch": "pnpm -r test:unit --watch",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --ignore-path .oxfmtignore .",
    "format:check": "oxfmt --ignore-path .oxfmtignore --check .",
    "typecheck:fast": "pnpm --filter \"./packages/*\" exec tsgo --noEmit",
    "preflight": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test:unit && pnpm test:a11y && pnpm build",
    "ci": "pnpm test:all",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "release": "pnpm --filter=rafters build"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@cloudflare/vitest-pool-workers": "catalog:",
    "@playwright/test": "catalog:",
    "@tailwindcss/cli": "^4.1.18",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@typescript/native-preview": "7.0.0-dev.20260630.1",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "esbuild": "catalog:",
    "happy-dom": "catalog:",
    "lefthook": "catalog:",
    "msw": "catalog:",
    "oxfmt": "0.41.0",
    "oxlint": "1.56.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsx": "^4.21.0",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zocker": "catalog:",
    "zod": "catalog:"
  },
  "engines": {
    "node": ">=24.12.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.9.0"
}
