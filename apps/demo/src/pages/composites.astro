---
import BaseLayout from '../layouts/BaseLayout.astro';
import Composite from '../lib/composites/Composite.astro';

// A selection of the demo's composites, rendered server-side by the engine.
const ids = [
  'hero-banner',
  'login-form',
  'feature-grid',
  'cta-section',
  'testimonial',
  'profile-card',
];
---

<BaseLayout title="Composites" description="Composite render test -- composites rendered server-side by the engine">
  <h1>Composite render test</h1>
  {
    ids.map((id) => (
      <section data-composite={id}>
        <p data-label>{id}</p>
        <Composite id={id} />
      </section>
    ))
  }
</BaseLayout>
