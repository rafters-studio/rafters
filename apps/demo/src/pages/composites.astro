---
import Composite from '../lib/composites/Composite.astro';

// A selection of the demo's composites, rendered server-side by the engine.
const ids = ['hero-banner', 'login-form', 'feature-grid', 'cta-section', 'testimonial', 'profile-card'];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Composite render test</title>
  </head>
  <body>
    <h1>Composite render test</h1>
    {
      ids.map((id) => (
        <section data-composite={id}>
          <p data-label>{id}</p>
          <Composite id={id} />
        </section>
      ))
    }
  </body>
</html>
