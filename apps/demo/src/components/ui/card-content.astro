---
/**
 * CardContent -- the body region. Horizontal inset only (`px-6`); the vertical
 * rhythm belongs to the Card root's `flex flex-col gap-6 py-6`, which is what
 * lets an arbitrary child dropped straight into a Card share the same rhythm.
 *
 * `class` is NOT a prop; design travels through token props only.
 *
 * @parent card
 */
import type { HTMLAttributes } from 'astro/types';
import { cardContentClasses } from '@/components/ui/card.classes';

type Props = Omit<HTMLAttributes<'div'>, 'class'>;

const { class: _discardedClass, ...attrs } = Astro.props as Props & { class?: string };
---

<div data-slot="card-content" class={cardContentClasses} {...attrs}>
  <slot />
</div>
