---
/**
 * CardHeader -- the Astro performance of Card's header region, importable on
 * its own so an Astro tree composes exactly like the React tree:
 *
 *   <Card><CardHeader><CardTitle>...</CardTitle></CardHeader></Card>
 *
 * card.astro's named slots remain as a convenience; these files are the parity
 * surface. Both draw from the SAME class strings in card.classes.ts -- one
 * score, one composition, no drift.
 *
 * The header is a GRID (shadcn v4). CardAction placed as a direct child opens
 * the second column via the header's `has-data-[slot=card-action]` variant.
 *
 * `class` is NOT a prop -- design travels through token props only. It is
 * discarded so `...attrs` cannot carry it onto the element.
 *
 * @parent card
 */
import type { HTMLAttributes } from 'astro/types';
import { cardHeaderClasses } from '@/components/ui/card.classes';

type Props = Omit<HTMLAttributes<'div'>, 'class'>;

const { class: _discardedClass, ...attrs } = Astro.props as Props & { class?: string };
---

<div data-slot="card-header" class={cardHeaderClasses} {...attrs}>
  <slot />
</div>
